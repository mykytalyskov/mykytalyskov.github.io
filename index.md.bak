tegory set class to 'active' -->\n<li class=\" \">\n    <!-- IE fix: open new tab when using anhor with blank attribute -->\n    \n    <a id=\"39\" href=\"javascript:\"><span>cv</span></a>\n\n    \n    \n    <ul class=\"nav\" style=\"\">\n        <!-- help: https://stackoverflow.com/questions/20872861/jekyll-display-posts-by-category -->\n        \n\n        \n\n        <!-- find out is this item active -->\n        \n\n        <!-- link to vk or facebook account -->\n        \n            <!-- to mark the link set class to 'active' -->\n            <li class=\"\" style=\"display: none;\" data-selectable=\"true\">\n                <a id=\"40\" href=\"/cv/about\"><i><span>About Me</span></i></a>\n            </li>\n        \n        \n        \n    </ul>\n</li>\n    \n</ul>\n</div>\n\n<script src=\"/assets/js/category_view.js\"></script>\n      <div class=\"nav-bottom\">&nbsp;</div>\n    </nav>\n  </div>\n  <div id=\"content-wrap\" class=\"col-5\">\n      <!-- TODO: prev/next heavily depends on posts order defined in main_sidebar.html -->\n<div id=\"content-controls\" class=\"\">\n    <!-- Get page category -->\n    \n\n    <!-- Reversed order -->\n    <!-- Find first/last pages within the category -->\n    <!-- NOTE: Reversed order -->\n    \n    \n\n    <!-- Find next/previos pages within the category -->\n    <!-- NOTE: DON'T RELY ON page.next.url or page.previous.url -->\n    \n        \n            <!-- NOTE: Reversed order -->\n            \n            \n            \n            \n        \n    \n        \n    \n        \n    \n        \n    \n        \n    \n\n    \n        \n        <a id=\"prev\" href=\"/abstract-films/poland-residence\">&lt;</a>\n        \n\n        \n        <a id=\"next\" href=\"/abstract-films/dzob-techno-1\">&gt;</a>\n        \n    \n</div>\n\n<script src=\"/assets/js/content_controls.js\"></script>\n      <div id=\"content\" class=\"media\">\n        <div>\n          <!-- Is it page? -->\n\n\n<div>\n    <!-- All vars: https://jekyllrb.com/docs/variables/ -->\n\t<div class=\"media abstract-films\">\n        \n\n        <a href=\"javascript:\">\n            <img src=\"/assets/img/Spring.jpg\" alt=\"picture not found\"/>\n        </a>\n\n        <!-- Assume video url. -->\n        \n\n        \n        <div class=\"text\">\n            <div>\n                <strong>\n                    \n                    Spring\n                    \n                </strong>\n            </div>\n            <pre>Spring was the name of an old Soviet TV set that was produced in Ukraine. \nThis abstract movie is made up of noises that are recorded on this TV.\nSound and animation by: Mykyta Lyskov\n2023\n</pre>\n        </div>\n        \n\n        \n    </div>\n</div>\n\n<!-- Regular page -->\n\n\n<script src=\"/assets/js/media_wrapper.js\"></script>\n\n        </div>\n        <!-- see disqus in main_content -->\n      </div>\n  </div>\n  \n</div>\n\n<!-- Javascript for collapsing/expanding the menu -->\n<script src=\"/assets/js/lib/underscore.js\"></script>\n<script src=\"/assets/js/lib/jquery.js\"></script>\n<script src=\"/assets/js/lib/animqueue.js\"></script>\n<script src=\"/assets/js/common.js\"></script>\n\n<!-- Snow effect on site -->\n<!-- <script src=\"/assets/js/lib/snowstormv144_20131208/snowstorm.js\"></script> -->\n\n<!-- Google analytics -->\n<script>\n  (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){\n  (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),\n  m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)\n  })(window,document,'script','//www.google-analytics.com/analytics.js','ga');\n  ga('create', 'UA-68257324-1', 'auto');\n  ga('send', 'pageview');\n</script>\n\n\n\n\n</body>\n</html>\n","url":"/abstract-films/spring","id":"/abstract-films/spring","content":"\n","collection":"posts","relative_path":"abstract-films/_posts/2023-03-05-spring.md","excerpt":"\n","previous":{"path":"abstract-films/_posts/2023-03-01-poland-residence.md","url":"/abstract-films/poland-residence","id":"/abstract-films/poland-residence","collection":"posts","relative_path":"abstract-films/_posts/2023-03-01-poland-residence.md","draft":false,"categories":["abstract-films"],"layout":"main","title":"Poland residence","description":"In January, I was lucky to become a member of the residence for artists in Klementovice (Poland). \nI spent a pleasant 10 days there and drew 574 drawings, which later became this animation. \nIt turned out to be an interesting experiment, since during the residence \nI did not use animated gadgets, such as a lightbox or a computer, only paints and paper.\nMusic by Nikita Gavrilenko\n","media_url":"https://player.vimeo.com/video/352320638","published":true,"comments":false,"date":"2023-03-01 00:00:00 +0200","slug":"poland-residence","ext":".md","tags":[],"next_in_category":"<!-- HELP: https://shopify.github.io/liquid/basics/types/ -->\n<!DOCTYPE html>\n<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en-us\">\n<head>\n  <meta http-equiv=\"content-type\" content=\"text/html; charset=utf-8\" />\n  <meta name=\"description\" content=\"Nikita Liskov (Mykyta Lyskov) official site\" />\n  <meta name=\"keywords\" content=\"Никита Лыськов, Микита Лиськов, Mykyta Lyskov, Nikita Liskov, nikitaliskov, Кохання, deep love, днепр, Дніпро, Dnipro\" />\n  <meta name=\"author\" content=\"Nikita Liskov (Mykyta Lyskov)\" />\n  <title>Imaginary Landscapes - N I K I T A&nbsp;&nbsp;&nbsp;L I S K O V</title>\n  <!-- Site theme -->\n  \n\n  <link rel=\"stylesheet\" href=\"/assets/css/lib/bootstrap.css\"/>\n<link rel=\"stylesheet\" href=\"/assets/css/all.css\"/>\n<link rel=\"stylesheet\" href=\"/assets/css/small.css\"/>\n  \n  <!-- Begin Jekyll SEO tag v2.2.3 -->\n<title>Imaginary Landscapes | Nikita Liskov’s Home Site</title>\n<meta property=\"og:title\" content=\"Imaginary Landscapes\" />\n<meta name=\"author\" content=\"Nikita Liskov\" />\n<meta property=\"og:locale\" content=\"[\"en\", \"uk\"]\" />\n<meta name=\"description\" content=\"The abstract film “Imaginary Landscapes “ consists of watercolor drawings measuring 9x5 cm. This animation was created in 2019 as part of a personal exhibition (Movement) in the Artsvit gallery (Dnipro). In 2020, the festival premiere of this movie took place at the Linoleum festival. In 2022, “Imaginary Landscape “ won the grand prize in the abstract animation competition at the Anifilm festival (Czech Republic).\" />\n<meta property=\"og:description\" content=\"The abstract film “Imaginary Landscapes “ consists of watercolor drawings measuring 9x5 cm. This animation was created in 2019 as part of a personal exhibition (Movement) in the Artsvit gallery (Dnipro). In 2020, the festival premiere of this movie took place at the Linoleum festival. In 2022, “Imaginary Landscape “ won the grand prize in the abstract animation competition at the Anifilm festival (Czech Republic).\" />\n<link rel=\"canonical\" href=\"http://nikitaliskov.com/abstract-films/imaginary-landscapes\" />\n<meta property=\"og:url\" content=\"http://nikitaliskov.com/abstract-films/imaginary-landscapes\" />\n<meta property=\"og:site_name\" content=\"Nikita Liskov’s Home Site\" />\n<meta property=\"og:type\" content=\"article\" />\n<meta property=\"article:published_time\" content=\"2021-11-01T00:00:00+02:00\" />\n<script type=\"application/ld+json\">\n{\"@context\":\"http://schema.org\",\"@type\":\"BlogPosting\",\"headline\":\"Imaginary Landscapes\",\"author\":{\"@type\":\"Person\",\"name\":\"Nikita Liskov\"},\"datePublished\":\"2021-11-01T00:00:00+02:00\",\"dateModified\":\"2021-11-01T00:00:00+02:00\",\"description\":\"The abstract film “Imaginary Landscapes “ consists of watercolor drawings measuring 9x5 cm. This animation was created in 2019 as part of a personal exhibition (Movement) in the Artsvit gallery (Dnipro). In 2020, the festival premiere of this movie took place at the Linoleum festival. In 2022, “Imaginary Landscape “ won t