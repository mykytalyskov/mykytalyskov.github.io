>\n</li>\n    \n        \n        \n        <!-- another loop to find out is this top item active -->\n\n\n    \n\n\n<!-- to open category set class to 'active' -->\n<li class=\" \">\n    <!-- IE fix: open new tab when using anhor with blank attribute -->\n    \n    <a id=\"39\" href=\"javascript:\"><span>cv</span></a>\n\n    \n    \n    <ul class=\"nav\" style=\"\">\n        <!-- help: https://stackoverflow.com/questions/20872861/jekyll-display-posts-by-category -->\n        \n\n        \n\n        <!-- find out is this item active -->\n        \n\n        <!-- link to vk or facebook account -->\n        \n            <!-- to mark the link set class to 'active' -->\n            <li class=\"\" style=\"display: none;\" data-selectable=\"true\">\n                <a id=\"40\" href=\"/cv/about\"><i><span>About Me</span></i></a>\n            </li>\n        \n        \n        \n    </ul>\n</li>\n    \n</ul>\n</div>\n\n<script src=\"/assets/js/category_view.js\"></script>\n      <div class=\"nav-bottom\">&nbsp;</div>\n    </nav>\n  </div>\n  <div id=\"content-wrap\" class=\"col-5\">\n      <!-- TODO: prev/next heavily depends on posts order defined in main_sidebar.html -->\n<div id=\"content-controls\" class=\"\">\n    <!-- Get page category -->\n    \n\n    <!-- Reversed order -->\n    <!-- Find first/last pages within the category -->\n    <!-- NOTE: Reversed order -->\n    \n    \n\n    <!-- Find next/previos pages within the category -->\n    <!-- NOTE: DON'T RELY ON page.next.url or page.previous.url -->\n    \n        \n    \n        \n    \n        \n            <!-- NOTE: Reversed order -->\n            \n            \n            \n            \n        \n    \n        \n    \n        \n    \n\n    \n        \n        <a id=\"prev\" href=\"/abstract-films/dzob-techno-2\">&lt;</a>\n        \n\n        \n        <a id=\"next\" href=\"/abstract-films/poland-residence\">&gt;</a>\n        \n    \n</div>\n\n<script src=\"/assets/js/content_controls.js\"></script>\n      <div id=\"content\" class=\"media\">\n        <div>\n          <!-- Is it page? -->\n\n\n<div>\n    <!-- All vars: https://jekyllrb.com/docs/variables/ -->\n\t<div class=\"media abstract-films\">\n        \n\n        <iframe src=\"https://www.youtube.com/embed/vTPIUFy4k7E\" width=\"500\" height=\"281\" frameborder=\"0\" allowfullscreen=\"\"></iframe>\n\n        \n\n        \n        <div class=\"text\">\n            <div>\n                <strong>\n                    \n                    Imaginary Landscapes\n                    \n                </strong>\n            </div>\n            <pre>The abstract film \"Imaginary Landscapes \" consists of watercolor drawings measuring 9x5 cm. \nThis animation was created in 2019 as part of a personal exhibition (Movement) in the Artsvit gallery (Dnipro). \nIn 2020, the festival premiere of this movie took place at the Linoleum festival. \nIn 2022, \"Imaginary Landscape \" won the grand prize in the abstract animation competition at the Anifilm festival (Czech Republic).\n</pre>\n        </div>\n        \n\n        \n    </div>\n</div>\n\n<!-- Regular page -->\n\n\n<script src=\"/assets/js/media_wrapper.js\"></script>\n\n        </div>\n        <!-- see disqus in main_content -->\n      </div>\n  </div>\n  \n</div>\n\n<!-- Javascript for collapsing/expanding the menu -->\n<script src=\"/assets/js/lib/underscore.js\"></script>\n<script src=\"/assets/js/lib/jquery.js\"></script>\n<script src=\"/assets/js/lib/animqueue.js\"></script>\n<script src=\"/assets/js/common.js\"></script>\n\n<!-- Snow effect on site -->\n<!-- <script src=\"/assets/js/lib/snowstormv144_20131208/snowstorm.js\"></script> -->\n\n<!-- Google analytics -->\n<script>\n  (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){\n  (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),\n  m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)\n  })(window,document,'script','//www.google-analytics.com/analytics.js','ga');\n  ga('create', 'UA-68257324-1', 'auto');\n  ga('send', 'pageview');\n</script>\n\n\n\n\n</body>\n</html>\n","previous_in_category":"<!-- HELP: https://shopify.github.io/liquid/basics/types/ -->\n<!DOCTYPE html>\n<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en-us\">\n<head>\n  <meta http-equiv=\"content-type\" content=\"text/html; charset=utf-8\" />\n  <meta name=\"description\" content=\"Nikita Liskov (Mykyta Lyskov) official site\" />\n  <meta name=\"keywords\" content=\"Никита Лыськов, Микита Лиськов, Mykyta Lyskov, Nikita Liskov, nikitaliskov, Кохання, deep love, днепр, Дніпро, Dnipro\" />\n  <meta name=\"author\" content=\"Nikita Liskov (Mykyta Lyskov)\" />\n  <title>Spring - N I K I T A&nbsp;&nbsp;&nbsp;L I S K O V</title>\n  <!-- Site theme -->\n  \n\n  <link rel=\"stylesheet\" href=\"/assets/css/lib/bootstrap.css\"/>\n<link rel=\"stylesheet\" href=\"/assets/css/all.css\"/>\n<link rel=\"stylesheet\" href=\"/assets/css/small.css\"/>\n  \n  <!-- Begin Jekyll SEO tag v2.2.3 -->\n<title>Spring | Nikita Liskov’s Home Site</title>\n<meta property=\"og:title\" content=\"Spring\" />\n<meta name=\"author\" content=\"Nikita Liskov\" />\n<meta property=\"og:locale\" content=\"[\"en\", \"uk\"]\" />\n<meta name=\"description\" content=\"Spring was the name of an old Soviet TV set that was produced in Ukraine. This abstract movie is made up of noises that are recorded on this TV. Sound and animation by: Mykyta Lyskov 2023\" />\n<meta property=\"og:description\" content=\"Spring was the name of an old Soviet TV set that was produced in Ukraine. This abstract movie is made up of noises that are recorded on this TV. Sound and animation by: Mykyta Lyskov 2023\" />\n<link rel=\"canonical\" href=\"http://nikitaliskov.com/abstract-films/spring\" />\n<meta property=\"og:url\" content=\"http://nikitaliskov.com/abstract-films/spring\" />\n<meta property=\"og:site_name\" content=\"Nikita Liskov’s Home Site\" />\n<meta property=\