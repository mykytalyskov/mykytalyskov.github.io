s item active -->\n        \n\n        <!-- link to vk or facebook account -->\n        \n            <!-- to mark the link set class to 'active' -->\n            <li class=\"\" style=\"\" data-selectable=\"true\">\n                <a id=\"11\" href=\"/abstract-films/dzob-techno-1\"><i><span>DZ'OB - Techno 1</span></i></a>\n            </li>\n        \n        \n        \n\n        \n\n        <!-- find out is this item active -->\n        \n\n        <!-- link to vk or facebook account -->\n        \n            <!-- to mark the link set class to 'active' -->\n            <li class=\"\" style=\"\" data-selectable=\"true\">\n                <a id=\"12\" href=\"/abstract-films/dzob-techno-2\"><i><span>DZ'OB - Techno 2</span></i></a>\n            </li>\n        \n        \n        \n\n        \n\n        <!-- find out is this item active -->\n        \n\n        <!-- link to vk or facebook account -->\n        \n            <!-- to mark the link set class to 'active' -->\n            <li class=\"\" style=\"\" data-selectable=\"true\">\n                <a id=\"13\" href=\"/abstract-films/imaginary-landscapes\"><i><span>Imaginary Landscapes</span></i></a>\n            </li>\n        \n        \n        \n\n        \n\n        <!-- find out is this item active -->\n        \n\n        <!-- link to vk or facebook account -->\n        \n            <!-- to mark the link set class to 'active' -->\n            <li class=\"\" style=\"\" data-selectable=\"true\">\n                <a id=\"14\" href=\"/abstract-films/poland-residence\"><i><span>Poland residence</span></i></a>\n            </li>\n        \n        \n        \n\n        \n\n        <!-- find out is this item active -->\n        \n\n        <!-- link to vk or facebook account -->\n        \n            <!-- to mark the link set class to 'active' -->\n            <li class=\"\" style=\"\" data-selectable=\"true\">\n                <a id=\"15\" href=\"/abstract-films/spring\"><i><span>Spring</span></i></a>\n            </li>\n        \n        \n        \n    </ul>\n</li>\n    \n        \n        \n        <!-- another loop to find out is this top item active -->\n\n\n    \n\n    \n\n    \n\n\n<!-- to open category set class to 'active' -->\n<li class=\" \">\n    <!-- IE fix: open new tab when using anhor with blank attribute -->\n    \n    <a id=\"16\" href=\"javascript:\"><span>student-films</span></a>\n\n    \n    \n    <ul class=\"nav\" style=\"\">\n        <!-- help: https://stackoverflow.com/questions/20872861/jekyll-display-posts-by-category -->\n        \n\n        \n\n        <!-- find out is this item active -->\n        \n\n        <!-- link to vk or facebook account -->\n        \n            <!-- to mark the link set class to 'active' -->\n            <li class=\"\" style=\"\" data-selectable=\"true\">\n                <a id=\"17\" href=\"/student-films/the-boy\"><i><span>The boy</span></i></a>\n            </li>\n        \n        \n        \n\n        \n\n        <!-- find out is this item active -->\n        \n\n        <!-- link to vk or facebook account -->\n        \n            <!-- to mark the link set class to 'active' -->\n            <li class=\"\" style=\"\" data-selectable=\"true\">\n                <a id=\"18\" href=\"/student-films/doors\"><i><span>Doors</span></i></a>\n            </li>\n        \n        \n        \n\n        \n\n        <!-- find out is this item active -->\n        \n\n        <!-- link to vk or facebook account -->\n        \n            <!-- to mark the link set class to 'active' -->\n            <li class=\"\" style=\"\" data-selectable=\"true\">\n                <a id=\"19\" href=\"/student-films/birds\"><i><span>Birds</span></i></a>\n            </li>\n        \n        \n        \n    </ul>\n</li>\n    \n        \n        \n        <!-- another loop to find out is this top item active -->\n\n\n    \n\n    \n\n    \n\n\n<!-- to open category set class to 'active' -->\n<li class=\" \">\n    <!-- IE fix: open new tab when using anhor with blank attribute -->\n    \n    <a id=\"20\" href=\"javascript:\"><span>other-films</span></a>\n\n    \n    \n    <ul class=\"nav\" style=\"\">\n        <!-- help: https://stackoverflow.com/questions/20872861/jekyll-display-posts-by-category -->\n        \n\n        \n\n        <!-- find out is this item active -->\n        \n\n        <!-- link to vk or facebook account -->\n        \n            <!-- to mark the link set class to 'active' -->\n            <li class=\"\" style=\"\" data-selectable=\"true\">\n                <a id=\"21\" href=\"/other-films/putler-kaput\"><i><span>Putler Kaput!</span></i></a>\n            </li>\n        \n        \n        \n\n        \n\n        <!-- find out is this item active -->\n        \n\n        <!-- link to vk or facebook account -->\n        \n            <!-- to mark the link set class to 'active' -->\n            <li class=\"\" style=\"\" data-selectable=\"true\">\n                <a id=\"22\" href=\"/other-films/becoming-human\"><i><span>Becoming Human</span></i></a>\n            </li>\n        \n        \n        \n\n        \n\n        <!-- find out is this item active -->\n        \n\n        <!-- link to vk or facebook account -->\n        \n            <!-- to mark the link set class to 'active' -->\n            <li class=\"\" style=\"\" data-selectable=\"true\">\n                <a id=\"23\" href=\"/other-films/linoleum\"><i><span>Animation school ...</span></i></a>\n            </li>\n        \n        \n        \n    </ul>\n</li>\n    \n        \n        \n        <!-- another loop to find out is this top item active -->\n\n\n    \n\n    \n\n    \n\n    \n        \n        \n\n<!-- to open category set class to 'active' -->\n<li class=\"active \">\n    <!-- IE fix: open new tab when using anhor with blank attribute -->\n    \n    <a id=\"24\" href=\"javascript:\"><span>press</span></a>\n\n    \n    \n    <ul class=\"nav\" style=\"\">\n        <!-- help: https://stackoverflow.com/questions/20872861/jekyll-display-posts-by-category -->\n        \n\n        \n\n        <!-- find out is this item active -->\n        \n\n        <!-- link to vk or facebook account -->\n        \n            <!-- to mark the link set class to 'active' -->\n            <li class=\"\" style=\"\" data-selectable=\"true\">\n                <a id=\"25\" href=\"/press/animation-black-humor\"><i><span>Анімація, чорний ...</span></i></a>\n            </li>\n        \n        \n        \n\n        \n\n        <!-- find out is this item active -->\n        \n\n        <!-- link to vk or facebook account -->\n        \n            <!-- to mark the link set class to 'active' -->\n            <li class=\"active\" style=\"\" data-selectable=\"true\">\n                <a id=\"26\" href=\"/press/press\"><i><span>Дмитро Десятерик ...</span></i></a>\n            </li>\n        \n        \n        \n\n        \n\n        <!-- find out is this item active -->\n        \n\n        <!-- link to vk or facebook account -->\n        \n            <!-- to mark the link set class to 'active' -->\n            <!-- add 'float: left' to get rid of extra space between inline-block items  -->\n            <li class=\"\" style=\"\">\n                <a id=\"27\" href=\"https://lb.ua/culture/2019/07/02/431030_nikita_liskov_ya_viros.html\" target=\"blank\"><i><span>Культура</span></i></a>\n            </li>\n        \n        \n        \n\n        \n\n        <!-- find out is this item active -->\n        \n\n        <!-- link to vk or facebook account -->\n        \n            <!-- to mark the link set class to 'active' -->\n            <!-- add 'float: left' to get rid of extra space between inline-block items  -->\n            <li class=\"\" style=\"\">\n                <a id=\"28\" href=\"https://donttakefake.com/rezhiser-kohannya-mikita-liskov-pro-romantiku-dnipra-golovu-lenina-ta-syurrealizm/\" target=\"blank\"><i><span>Романтика</span></i></a>\n            </li>\n        \n        \n        \n\n        \n\n  