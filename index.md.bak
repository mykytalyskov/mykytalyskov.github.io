\n                <strong>\n                    \n                    Putler Kaput!\n                    \n                </strong>\n            </div>\n            <pre>Animation jam \"putler Kaput!\"\nAfter a full-scale russian invasion in Ukraine and escalation of the war \nanimators from all over the world united to kill putin! At least on a screen.\nUkraine 2022\n</pre>\n        </div>\n        \n\n        \n    </div>\n</div>\n\n<!-- Regular page -->\n\n\n<script src=\"/assets/js/media_wrapper.js\"></script>\n\n        </div>\n        <!-- see disqus in main_content -->\n      </div>\n  </div>\n  \n</div>\n\n<!-- Javascript for collapsing/expanding the menu -->\n<script src=\"/assets/js/lib/underscore.js\"></script>\n<script src=\"/assets/js/lib/jquery.js\"></script>\n<script src=\"/assets/js/lib/animqueue.js\"></script>\n<script src=\"/assets/js/common.js\"></script>\n\n<!-- Snow effect on site -->\n<!-- <script src=\"/assets/js/lib/snowstormv144_20131208/snowstorm.js\"></script> -->\n\n<!-- Google analytics -->\n<script>\n  (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){\n  (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),\n  m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)\n  })(window,document,'script','//www.google-analytics.com/analytics.js','ga');\n  ga('create', 'UA-68257324-1', 'auto');\n  ga('send', 'pageview');\n</script>\n\n\n\n\n</body>\n</html>\n","url":"/other-films/putler-kaput","id":"/other-films/putler-kaput","content":"\n","collection":"posts","relative_path":"other-films/_posts/2023-03-31-putler-kaput.md","excerpt":"\n","previous":{"path":"student-films/_posts/2023-03-15-birds.md","url":"/student-films/birds","id":"/student-films/birds","collection":"posts","relative_path":"student-films/_posts/2023-03-15-birds.md","draft":false,"categories":["student-films"],"layout":"main","title":"Birds","description":"Sound and animation by: Mykyta Lyskov (Nikita L