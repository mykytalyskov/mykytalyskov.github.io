        \n\n        \n        <a id=\"next\" href=\"/press/animation-black-humor\">&gt;</a>\n        \n    \n</div>\n\n<script src=\"/assets/js/content_controls.js\"></script>\n      <div id=\"content\" class=\"media\">\n        <div>\n          <!-- Is it page? -->\n\n\n<h3 id=\"Про-мультяшну-реальність-Дніпра\"><a href=\"https://soundcloud.app.goo.gl/5FB3e\">Про мультяшну реальність Дніпра</a></h3>\n\n<p>Микита Лиськов: про мультяшну реальність Дніпра<br />\nГерой епізоду — мультиплікатор із Дніпра Микита Лиськов.<br />\nПро мультяшну реальність, гібридне оточення та спробу<br />\nвижити — у першому випуску подкасту «Тепер».</p>\n\n<p><a href=\"https://soundcloud.app.goo.gl/5FB3e\"><img src=\"https://i1.sndcdn.com/artworks-R34Fzgb6IQYv5QNa-2kNSqw-t500x500.jpg\" alt=\"Article\" /></a></p>\n\n\n\n\n<script src=\"/assets/js/media_wrapper.js\"></script>\n\n        </div>\n        <!-- see disqus in main_content -->\n      </div>\n  </div>\n  \n</div>\n\n<!-- Javascript for collapsing/expanding the menu -->\n<script src=\"/assets/js/lib/underscore.js\"></script>\n<script src=\"/assets/js/lib/jquery.js\"></script>\n<script src=\"/assets/js/lib/animqueue.js\"></script>\n<script src=\"/assets/js/common.js\"></script>\n\n<!-- Snow effect on site -->\n<!-- <script src=\"/assets/js/lib/snowstormv144_20131208/snowstorm.js\"></script> -->\n\n<!-- Google analytics -->\n<script>\n  (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){\n  (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),\n  m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)\n  })(window,document,'script','//www.google-analytics.com/analytics.js','ga');\n  ga('create', 'UA-68257324-1', 'auto');\n  ga('send', 'pageview');\n</script>\n\n\n\n\n</body>\n</html>\n"},"draft":false,"categories":["press"],"layout":"main","title":"Реальність","external_url":"https://soundcloud.app.goo.gl/5FB3e","published":true,"comments":false,"date":"2021-11