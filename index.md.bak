m/video/352320638\" width=\"500\" height=\"281\" frameborder=\"0\" allowfullscreen=\"\"></iframe>\n\n        \n\n        \n        <div class=\"text\">\n            <div>\n                <strong>\n                    \n                    Poland residence\n                    \n                </strong>\n            </div>\n            <pre>In January, I was lucky to become a member of the residence for artists in Klementovice (Poland). \nI spent a pleasant 10 days there and drew 574 drawings, which later became this animation. \nIt turned out to be an interesting experiment, since during the residence \nI did not use animated gadgets, such as a lightbox or a computer, only paints and paper.\nMusic by Nikita Gavrilenko\n</pre>\n        </div>\n        \n\n        \n    </div>\n</div>\n\n<!-- Regular page -->\n\n\n<script src=\"/assets/js/media_wrapper.js\"></script>\n\n        </div>\n        <!-- see disqus in main_content -->\n      </div>\n  </div>\n  \n</div>\n\n<!-- Javascript for collapsing/expanding the menu -->\n<script src=\"/assets/js/lib/underscore.js\"></script>\n<script src=\"/assets/js/lib/jquery.js\"></script>\n<script src=\"/assets/js/lib/animqueue.js\"></script>\n<script src=\"/assets/js/common.js\"></script>\n\n<!-- Snow effect on site -->\n<!-- <script src=\"/assets/js/lib/snowstormv144_20131208/snowstorm.js\"></script> -->\n\n<!-- Google analytics -->\n<script>\n  (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){\n  (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),\n  m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)\n  })(window,document,'script','//www.google-analytics.com/analytics.js','ga');\n  ga('create', 'UA-68257324-1', 'auto');\n  ga('send', 'pageview');\n</script>\n\n\n\n\n</body>\n</html>\n"},{"next":{"path":"abstract-films/_posts/2023-03-05-spring.md","url":"/abstract-films/spring","id":"/abstract-films/spring","collection":"posts","relative_path":"