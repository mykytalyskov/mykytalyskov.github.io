r]||function(){\n  (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),\n  m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)\n  })(window,document,'script','//www.google-analytics.com/analytics.js','ga');\n  ga('create', 'UA-68257324-1', 'auto');\n  ga('send', 'pageview');\n</script>\n\n\n\n\n</body>\n</html>\n","url":"/narrative-films/kyiv-cake","id":"/narrative-films/kyiv-cake","content":"\n","collection":"posts","relative_path":"narrative-films/_posts/2025-11-20-kyiv-cake.md","excerpt":"\n","previous":{"path":"other-films/_posts/2023-04-01-linoleum.md","url":"/other-films/linoleum","id":"/other-films/linoleum","collection":"posts","relative_path":"other-films/_posts/2023-04-01-linoleum.md","draft":false,"categories":["other-films"],"layout":"main","title":"Animation school \"Linoleum\"","description":"Compilation of the works of the animation school \"Linoleum\" students\nDnipro, Ukraine\nMusic - Radiohead - Decks Dark\n2016\n","media_url":"https://player.vimeo.com/video/168838065","published":true,"comments":false,"date":"2023-04-01 00:00:00 +0300","slug":"linoleum","ext":".md","tags":[],"next_in_category":"<!-- HELP: https://shopify.github.io/liquid/basics/types/ -->\n<!DOCTYPE html>\n<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en-us\">\n<head>\n  <meta http-equiv=\"content-type\" content=\"text/html; charset=utf-8\" />\n  <meta name=\"description\" content=\"Nikita Liskov (Mykyta Lyskov) official site\" />\n  <meta name=\"keywords\" content=\"Никита Лыськов, Микита Лиськов, Mykyta Lyskov, Nikita Liskov, nikitaliskov, Кохання, deep love, днепр, Дніпро, Dnipro\" />\n  <meta name=\"author\" content=\"Nikita Liskov (Mykyta Lyskov)\" />\n  <title>Becoming Human - N I K I T A&nbsp;&nbsp;&nbsp;L I S K O V</title>\n  <!-- Site theme -->\n  \n\n  <link rel=\"stylesheet\" href=\"/assets/css/lib/bootstrap.css\"/>\n<link rel=\"stylesheet\" href=\"/assets/css/all.css\"/>\n<link rel=\"stylesheet